{
  "name": "cof2-character-creator",
  "version": "1.0.3",
  "description": "Application de création et gestion de personnages pour Chroniques Oubliées Fantasy 2",
  "author": {
    "name": "Faerian",
    "email": "faerian@gmail.com"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "data:editor": "vite --config tools/data-editor/vite.config.mts",
    "test": "vitest run",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run compile:electron && concurrently -k \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && npm run compile:electron && electron-builder",
    "build:mac": "npm run build && npm run compile:electron && electron-builder --mac",
    "build:win": "npm run build && npm run compile:electron && electron-builder --win"
  },
  "build": {
    "appId": "com.cof2.charactercreator",
    "productName": "COF2 Compagnon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
